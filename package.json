{
  "name": "local-views-for-youtube",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that counts how many times you personally watched each YouTube video. All data stays on your device.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "levanci",
  "homepage": "https://github.com/LevHabarov/local-views-for-youtube#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LevHabarov/local-views-for-youtube.git"
  },
  "bugs": {
    "url": "https://github.com/LevHabarov/local-views-for-youtube/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
